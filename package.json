{
  "name": "iconify-set",
  "version": "0.3.0",
  "type": "module",
  "description": "使用 Iconify 图标集为思源笔记的每个文档设置图标",
  "repository": "https://github.com/Halory-Ito/siyuan-plugin-iconify-set",
  "homepage": "https://github.com/Halory-Ito/siyuan-plugin-iconify-set",
  "author": "Halory",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "cross-env NODE_ENV=production vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "set-version": "node --no-warnings ./scripts/set_version.js",
    "check": "node ./scripts/check_package.mjs",
    "check:zip": "node ./scripts/check_package.mjs --zip package.zip",
    "check:strict": "node ./scripts/check_package.mjs --strict-url",
    "make-install": "vite build && node --no-warnings ./scripts/make_install.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.3.0",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.2.12",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.1.2",
    "svelte": "^4.2.20",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5"
  },
  "dependencies": {
    "iconify-icon": "^3.0.1"
  }
}
